<launch>
  <arg name="headless" default="False"/>

  <include file="$(find dragon_valve)/launch/include/dragon_bringup.launch">
    <arg name="real_machine" value="False" />
    <arg name="simulation" value="True" />
    <arg name="headless" value="$(arg headless)" />
  </include>

  <!-- test codes -->

  <!-- 2. control -->
  <test test-name="control_test" pkg="hydrus" type="control_check.py"  name="control_test" ns="dragon" time-limit="180" retry="100" >
    <rosparam>
      hovering_duration: 15.0
      convergence_thresholds: [0.02, 0.02, 0.02] # hovering threshold
      init_joint_names: ['joint1_pitch', 'joint1_yaw', 'joint2_pitch', 'joint2_yaw', 'joint3_pitch', 'joint3_yaw']
      init_joint_angles: [0, 1.57, 0, 1.57, 0, 1.57]
      tasks:
        - command: "rosrun dragon_valve gimbal_wind_test.py __ns:=dragon _wind_gimbal:=true"
          threshold: [0.1, 0.08, 0.8]
          angle_threshold: 0.02
          timeout: 15
          reset_duration: 0
        - command: "rostopic pub -1 /dragon/teleop_command/land std_msgs/Empty '{}'"
          threshold: [0.15, 0.08, 0.12]
          angle_threshold: 0.02
          timeout: 3
    </rosparam>
    <param name="init_form_duration" value="25.0" />
    <param name="init_angle_threshold" value="0.04" />
  </test>


</launch>
